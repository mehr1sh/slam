# --- pixi environment (recreate with `pixi install`) ---
.pixi/*
!.pixi/config.toml

# --- CMake / C++ build artifacts ---
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
Makefile
compile_commands.json
*.o
*.obj
*.a
*.so
*.dylib
*.exe

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Blender: the scene is generated by visualization/scripts/build_scene.py ---
visualization/scenes/*.blend
*.blend1
*.blend2
*.blend3
*.crash.txt
visualization/output/

# --- generated test outputs (written by the executables to ../output/) ---
output/

# --- LaTeX build by-products (presentation/) ---
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz

# --- editors / tooling / OS ---
.cache/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
