# --- pixi environment (recreate with `pixi install`) ---
.pixi/*
!.pixi/config.toml

# --- CMake / C++ build artifacts ---
build/
# side builds used by the ICP and visualization drivers (pixi icp-build, visualize_frontend.sh, rebuild_blender.sh)
build-icp/
build-scratch/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
Makefile
compile_commands.json
*.o
*.obj
*.a
*.so
*.dylib
*.exe

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Blender: the Bunny scene results/blender/bunny_slam_demo.blend is tracked; generated scenes are not ---
visualization/scenes/*.blend
visualization/scenes/tum/
*.blend1
*.blend2
*.blend3
*.crash.txt
# Blender renders of results/blender/bunny_slam_demo.blend (frame_####.png)
results/render/

# --- runtime output: the default destination of every program and script (disposable) ---
results/runs/

# --- generated diagnostics (tools/evaluation/run_diagnostics.py); the .md reports are tracked ---
results/reports/diagnostics/cpp/
results/reports/diagnostics/figures/
results/reports/diagnostics/*.csv
results/reports/diagnostics/summary_generated.md

# --- TUM RGB-D sequences: external dataset ($SLAM_TUM_ROOT), or a directory / link placed here
#     by hand; never tracked (docs/DATA_AND_ARCHIVE.md) ---
data/rgbd_dataset_*

# --- logs written by programs and scripts ---
*.log

# --- editors / tooling / OS ---
.cache/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
